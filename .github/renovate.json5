{
    "extends": [
        "github>thekevjames/tools:personal",
        "github>thekevjames/tools//renovate/version-as-app.json5",
    ],
    "packageRules": [
        {
            "matchManagers": ["terraform"],
            "matchDepNames": [
                "/^hashicorp/terraform$/",
                "/^terraform$/",
            ],
            "rangeStrategy": "widen",
        },
        {
            // See .pre-commit-config.yaml:default_language_version
            "groupName": "python",
            "matchDepNames": [
                "/^python$/",
                "/^python/cpython$/",
            ],
            "allowedVersions": "/^3\\.14(\\.|$)/",
        },
  ],
}
